{erl_opts, [debug_info]}.

{deps, [
    {hb, {git, "https://github.com/permaweb/hyperbeam.git", {ref, "7135fdba50821979880ab21179c21536621ce807"}}},
    %% Canonical generic mutable-reference device. Keep this external and
    %% pinned; playlist snapshots remain Odysee messages in the frontend.
    {reference_1_0, {git, "https://github.com/samcamwilliams/reference-1.0.git", {ref, "ca16e256af4eb2bf96406c41048d0e44851ce950"}}},
    %% SQLite FTS5 (bundled, FTS5 enabled) for the ~search@1.0 index.
    {esqlite, "0.8.6"}
]}.

%% On macOS under current rebar3 the `pc' plugin prints "Linking" but does
%% not produce port-spec NIFs (esqlite's, and hb's util-string/keccak), and
%% dependency post-hooks do not install HyperBEAM's HTML assets. Complete
%% those build steps explicitly. On Linux the NIF link steps are no-ops.
{post_hooks, [
    {compile,
        "sh -c '"
        "ERTS_INC=$(erl -noshell -eval "
        "\"io:format(\\\"~s/erts-~s/include\\\", "
        "[code:root_dir(), erlang:system_info(version)]), halt(0).\"); "
        "for D in _build/*/lib/esqlite; do "
        "if [ -f \"$D/c_src/esqlite3_nif.o\" ] && [ ! -f \"$D/priv/esqlite3_nif.so\" ]; then "
        "mkdir -p \"$D/priv\"; "
        "cc -shared -flat_namespace -undefined suppress "
        "-o \"$D/priv/esqlite3_nif.so\" "
        "\"$D/c_src/esqlite3_nif.o\" \"$D/c_src/sqlite3/sqlite3.o\" "
        "2>/dev/null; fi; done; "
        "for D in _build/*/lib/hb; do "
        "if [ -d \"$D/src/core/html\" ]; then "
        "mkdir -p \"$D/priv/html\"; "
        "cp -pR \"$D/src/core/html/.\" \"$D/priv/html/\"; "
        "fi; "
        "if [ -d \"$D/native\" ]; then mkdir -p \"$D/priv\"; "
        "[ -f \"$D/priv/hb_util_string.so\" ] || "
        "cc -O3 -shared -flat_namespace -undefined suppress -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_util_string.so\" "
        "\"$D/native/hb_util_string/hb_util_string.c\" 2>/dev/null; "
        "[ -f \"$D/priv/hb_keccak.so\" ] || "
        "cc -shared -flat_namespace -undefined suppress -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_keccak.so\" "
        "\"$D/native/hb_keccak/hb_keccak.c\" \"$D/native/hb_keccak/hb_keccak_nif.c\" "
        "2>/dev/null; fi; done; "
        "for D in _build/*/lib/elmdb; do "
        "if [ -f \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" ] && "
        "[ ! -f \"$D/priv/elmdb_nif.so\" ]; then "
        "cp \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" \"$D/priv/elmdb_nif.so\"; "
        "fi; done'"}
]}.

{plugins, [
    {plugin, {git_subdir, "https://github.com/permaweb/hyperbeam.git", {ref, "7135fdba50821979880ab21179c21536621ce807"}, "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

%% reference@1.0 currently lets its mutable default resolver intercept the
%% reserved message verification/authority operations. Apply the narrow,
%% upstream-ready fix before compiling the pinned external device.
{pre_hooks, [
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/secret-default-persist.patch; "
        "[ -f \"$D/src/preloaded/auth/dev_secret.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/reference_1_0; "
        "P=$PWD/patches/reference-message-operations.patch; "
        "[ -f \"$D/src/dev_reference.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"}
]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'odysee-local',
        [
            {device,
                "local --device-src src,_build/default/lib/reference_1_0/src"}
        ]},
    {'eunit-all',
        [
            {device,
                "test --device-src src,_build/default/lib/reference_1_0/src --with-core"}
        ]
    }
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
