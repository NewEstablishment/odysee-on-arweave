{erl_opts, [debug_info]}.

{deps, [
    {hb, {git, "https://github.com/permaweb/hyperbeam.git", {branch, "edge"}}},
    %% SQLite FTS5 (bundled, FTS5 enabled) for the ~search@1.0 index.
    {esqlite, "0.8.6"}
]}.

%% On macOS under current rebar3 the `pc' plugin prints "Linking" but does
%% not produce port-spec NIFs (esqlite's, and hb's util-string/keccak);
%% link them explicitly if missing. On Linux the `pc' link runs normally
%% and this is a no-op.
{post_hooks, [
    {compile,
        "sh -c '"
        "ERTS_INC=$(erl -noshell -eval "
        "\"io:format(\\\"~s/erts-~s/include\\\", "
        "[code:root_dir(), erlang:system_info(version)]), halt(0).\"); "
        "for D in _build/*/lib/esqlite; do "
        "if [ -f \"$D/c_src/esqlite3_nif.o\" ] && [ ! -f \"$D/priv/esqlite3_nif.so\" ]; then "
        "mkdir -p \"$D/priv\"; "
        "cc -shared -flat_namespace -undefined suppress "
        "-o \"$D/priv/esqlite3_nif.so\" "
        "\"$D/c_src/esqlite3_nif.o\" \"$D/c_src/sqlite3/sqlite3.o\" "
        "2>/dev/null; fi; done; "
        "for D in _build/*/lib/hb; do "
        "if [ -d \"$D/native\" ]; then mkdir -p \"$D/priv\"; "
        "[ -f \"$D/priv/hb_util_string.so\" ] || "
        "cc -O3 -shared -flat_namespace -undefined suppress -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_util_string.so\" "
        "\"$D/native/hb_util_string/hb_util_string.c\" 2>/dev/null; "
        "[ -f \"$D/priv/hb_keccak.so\" ] || "
        "cc -shared -flat_namespace -undefined suppress -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_keccak.so\" "
        "\"$D/native/hb_keccak/hb_keccak.c\" \"$D/native/hb_keccak/hb_keccak_nif.c\" "
        "2>/dev/null; fi; done; "
        "for D in _build/*/lib/elmdb; do "
        "if [ -f \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" ] && "
        "[ ! -f \"$D/priv/elmdb_nif.so\" ]; then "
        "cp \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" \"$D/priv/elmdb_nif.so\"; "
        "fi; done'"}
]}.

{plugins, [
    {plugin, {git_subdir, "https://github.com/permaweb/hyperbeam.git", {branch, "edge"}, "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'eunit-all',
        [
            {device, "test --with-core"}
        ]
    }
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
