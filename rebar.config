{erl_opts, [debug_info]}.

{deps, [
    %% ~search@1.0 indexes through Meilisearch over HTTP; no local engine.
    {hb, {git, "https://github.com/permaweb/hyperbeam.git", {ref, "2230df56e222adaf2aeefa945bc70c9db6b46cec"}}},
    %% Canonical generic mutable-reference device. Playlist snapshots remain
    %% ordinary Odysee messages; only stable pointer behavior lives here.
    {reference_1_0, {git, "https://github.com/samcamwilliams/reference-1.0.git", {ref, "ca16e256af4eb2bf96406c41048d0e44851ce950"}}}
]}.

%% Under current rebar3 the `pc' plugin may print "Linking" without producing
%% port-spec NIFs (hb's util-string/keccak), and dependency post-hooks do not
%% install HyperBEAM's HTML assets. Complete those build steps explicitly with
%% platform-appropriate shared-library flags.
{post_hooks, [
    {compile,
        "sh -c '"
        "ERTS_INC=$(erl -noshell -eval "
        "\"io:format(\\\"~s/erts-~s/include\\\", "
        "[code:root_dir(), erlang:system_info(version)]), halt(0).\"); "
        "case $(uname -s) in "
        "Darwin) SHARED_FLAGS=\"-shared -flat_namespace -undefined suppress\" ;; "
        "*) SHARED_FLAGS=\"-shared -fPIC\" ;; "
        "esac; "
        "for D in _build/*/lib/hb; do "
        "if [ -d \"$D/src/core/html\" ]; then "
        "mkdir -p \"$D/priv/html\"; "
        "cp -pR \"$D/src/core/html/.\" \"$D/priv/html/\"; "
        "fi; "
        "if [ -d \"$D/native\" ]; then mkdir -p \"$D/priv\"; "
        "[ -f \"$D/priv/hb_util_string.so\" ] || "
        "cc -O3 $SHARED_FLAGS -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_util_string.so\" "
        "\"$D/native/hb_util_string/hb_util_string.c\" 2>/dev/null; "
        "[ -f \"$D/priv/hb_keccak.so\" ] || "
        "cc $SHARED_FLAGS -I\"$ERTS_INC\" "
        "-o \"$D/priv/hb_keccak.so\" "
        "\"$D/native/hb_keccak/hb_keccak.c\" \"$D/native/hb_keccak/hb_keccak_nif.c\" "
        "2>/dev/null; fi; done; "
        "for D in _build/*/lib/elmdb; do "
        "if [ -f \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" ] && "
        "[ ! -f \"$D/priv/elmdb_nif.so\" ]; then "
        "cp \"$D/priv/crates/elmdb_nif/elmdb_nif.so\" \"$D/priv/elmdb_nif.so\"; "
        "fi; done'"}
]}.

{plugins, [
    {plugin, {git_subdir, "https://github.com/permaweb/hyperbeam.git", {ref, "2230df56e222adaf2aeefa945bc70c9db6b46cec"}, "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

%% Keep reserved message operations bound to the signed reference record rather
%% than letting the mutable default resolver dereference them first.
{pre_hooks, [
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/hyperbeam-hb-beamr-otp29.patch; "
        "[ -f \"$D/native/hb_beamr/hb_beamr.c\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/hb-http-single-range.patch; "
        "[ -f \"$D/src/core/http/hb_http.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/dev-cache-forward-range.patch; "
        "[ -f \"$D/src/preloaded/node/dev_cache.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/dev-query-match-error-tuple.patch; "
        "[ -f \"$D/src/preloaded/query/dev_query.erl\" ] || exit 0; "
        "git -C \"$D\" apply --unidiff-zero --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply --unidiff-zero \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/hb; "
        "P=$PWD/patches/secret-default-persist.patch; "
        "[ -f \"$D/src/preloaded/auth/dev_secret.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"},
    {compile,
        "sh -c 'D=_build/default/lib/reference_1_0; "
        "P=$PWD/patches/reference-message-operations.patch; "
        "[ -f \"$D/src/dev_reference.erl\" ] || exit 0; "
        "git -C \"$D\" apply --reverse --check \"$P\" >/dev/null 2>&1 && exit 0; "
        "git -C \"$D\" apply \"$P\"'"}
]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'odysee-local',
        [
            {device,
                "local --device-src src,_build/default/lib/reference_1_0/src"}
        ]},
    {'eunit-all',
        [
            {device,
                "test --device-src src,_build/default/lib/reference_1_0/src --with-core"}
        ]
    }
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
