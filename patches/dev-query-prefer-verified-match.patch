+    [preferred_query_match(maps:get(Key, Groups), Opts) || Key <- lists:reverse(OrderRev)].
+
+preferred_query_match(Paths, Opts) ->
+    InOrder = lists:reverse(Paths),
+    case lists:dropwhile(fun(Path) -> not query_match_verifies(Path, Opts) end, InOrder) of
+        [Verified | _] -> Verified;
+        [] -> hd(InOrder)
+    end.
+
+query_match_verifies(Path, Opts) ->
+    try
+        case hb_cache:read(Path, Opts) of
+            {ok, Msg} when is_map(Msg) ->
+                Loaded = hb_cache:ensure_all_loaded(Msg, Opts),
+                hb_message:verify(Loaded, #{ <<"commitment-ids">> => [Path] }, Opts);
+            _ ->
+                false
+        end
+    catch
+        _:_ -> false
+    end.
