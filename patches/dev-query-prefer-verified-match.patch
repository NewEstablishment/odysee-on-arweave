+            fun(Path, {Order, Acc}) ->
@@ -188,5 +188,5 @@ dedupe_query_matches(Matches, Opts) ->
-                case maps:is_key(Key, Seen) of
-                    true ->
-                        {Seen, Acc};
-                    false ->
-                        {maps:put(Key, true, Seen), [Path | Acc]}
+                case maps:find(Key, Acc) of
+                    {ok, _} ->
+                        {Order, maps:update_with(Key, fun(Paths) -> [Path | Paths] end, Acc)};
+                    error ->
+                        {[Key | Order], Acc#{ Key => [Path] }}
@@ -195 +195 @@ dedupe_query_matches(Matches, Opts) ->
