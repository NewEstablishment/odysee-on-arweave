+    ),
+    Trusted = hb_opts:get(blacklist_trusted_proxies, [], Opts),
+    Forwarded = hb_maps:get(<<"x-real-ip">>, Request, undefined, Opts),
+    Candidate = case lists:member(SocketIP, Trusted) of
