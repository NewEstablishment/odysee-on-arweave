+scoped_rule_decision(Rule, Location) ->
+    Countries = maps:get(<<"countries">>, Rule, []),
+    Continents = maps:get(<<"continents">>, Rule, []),
+    Groups = maps:get(<<"groups">>, Rule, []),
+    Country = maps:get(<<"country">>, Location, undefined),
+    Continent = maps:get(<<"continent">>, Location, undefined),
