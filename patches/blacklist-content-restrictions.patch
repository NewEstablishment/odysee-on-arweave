+    nested_get(Rest, maps:get(Key, Map, undefined));
+nested_get(_Path, _Value) -> undefined.
+
+%% @doc Return the first defined value in a list.
+first_defined([]) -> undefined;
+first_defined([undefined | Rest]) -> first_defined(Rest);
+first_defined([Value | _]) -> Value.
+
+%% @doc Normalize an optional location code.
+normalize_code(undefined) -> undefined;
+normalize_code(Value) -> uppercase(trim_ascii(hb_util:bin(Value))).
+
+%% @doc Normalize known country-group memberships from MMDB metadata.
+location_groups(undefined, true) -> [<<"EU">>];
+location_groups(undefined, false) -> [];
+location_groups(undefined, undefined) -> undefined;
+location_groups(Groups, _IsEUMember) when is_list(Groups) ->
+    lists:usort([normalize_code(Group) || Group <- Groups]);
+location_groups(Group, _IsEUMember) -> [normalize_code(Group)].
+
+%% @doc Test whether a binary is an exact hexadecimal value of a given length.
+is_hex(Bin, Length) when byte_size(Bin) =:= Length ->
+    lists:all(
+        fun(Char) ->
+            (Char >= $0 andalso Char =< $9)
+                orelse (Char >= $a andalso Char =< $f)
+                orelse (Char >= $A andalso Char =< $F)
+        end,
+        binary_to_list(Bin)
+    );
+is_hex(_Bin, _Length) -> false.
+
+%% @doc Test whether a binary is a canonical LBRY outpoint.
+is_outpoint(Bin) ->
+    case binary:split(Bin, <<":">>, [global]) of
+        [TxID, Nout] -> is_hex(TxID, 64) andalso is_digits(Nout);
+        _ -> false
+    end.
+
+%% @doc Test whether a non-empty binary contains only decimal digits.
+is_digits(<<>>) -> false;
+is_digits(Bin) ->
+    lists:all(fun(Char) -> Char >= $0 andalso Char =< $9 end, binary_to_list(Bin)).
+
+%% @doc Lowercase ASCII letters in a binary.
+lowercase(Bin) ->
+    << <<(case C of X when X >= $A, X =< $Z -> X + 32; _ -> C end)>> || <<C>> <= Bin >>.
+
+%% @doc Uppercase ASCII letters in a binary.
+uppercase(Bin) ->
+    << <<(case C of X when X >= $a, X =< $z -> X - 32; _ -> C end)>> || <<C>> <= Bin >>.
