-
+
+apply_http_range(Req, 200, Headers, Body) when is_binary(Body) ->
+    case {cowboy_req:method(Req), cowboy_req:header(<<"range">>, Req, undefined)} of
+        {<<"GET">>, Range} when is_binary(Range) ->
+            apply_http_range_value(Range, Headers, Body);
+        _ ->
+            {200, Headers, Body}
+    end;
+apply_http_range(_Req, Status, Headers, Body) ->
+    {Status, Headers, Body}.
+
+apply_http_range_value(Range, Headers, Body) ->
+    Size = byte_size(Body),
+    case parse_http_range(Range, Size) of
+        {ok, Start, End} ->
+            Length = End - Start + 1,
+            {
+                206,
+                (range_headers(Headers))#{
+                    <<"accept-ranges">> => <<"bytes">>,
+                    <<"content-range">> =>
+                        iolist_to_binary(
+                            io_lib:format("bytes ~B-~B/~B", [Start, End, Size])
+                        ),
+                    <<"content-length">> => integer_to_binary(Length)
+                },
+                binary:part(Body, Start, Length)
+            };
+        error ->
+            {
+                416,
+                (range_headers(Headers))#{
+                    <<"accept-ranges">> => <<"bytes">>,
+                    <<"content-range">> =>
+                        iolist_to_binary(io_lib:format("bytes */~B", [Size])),
+                    <<"content-length">> => <<"0">>
+                },
+                <<>>
+            }
+    end.
+
+range_headers(Headers) ->
+    maps:without(
+        [
+            <<"content-digest">>,
+            <<"content-length">>,
+            <<"signature">>,
+            <<"signature-input">>
+        ],
+        Headers
+    ).
+
+parse_http_range(<<"bytes=", Spec/binary>>, Size) when Size > 0 ->
+    case binary:split(Spec, <<",">>) of
+        [_Single] -> parse_http_range_spec(Spec, Size);
+        _ -> error
+    end;
+parse_http_range(_Range, _Size) ->
+    error.
+
+parse_http_range_spec(Spec, Size) ->
+    case binary:split(Spec, <<"-">>) of
+        [<<>>, SuffixBin] ->
+            case range_integer(SuffixBin) of
+                {ok, Suffix} when Suffix > 0 ->
+                    Start = max(0, Size - Suffix),
+                    {ok, Start, Size - 1};
+                _ -> error
+            end;
+        [StartBin, <<>>] ->
+            case range_integer(StartBin) of
+                {ok, Start} when Start < Size -> {ok, Start, Size - 1};
+                _ -> error
+            end;
+        [StartBin, EndBin] ->
+            case {range_integer(StartBin), range_integer(EndBin)} of
+                {{ok, Start}, {ok, End}} when Start =< End, Start < Size ->
+                    {ok, Start, min(End, Size - 1)};
+                _ -> error
+            end;
+        _ -> error
+    end.
+
+range_integer(Value) ->
+    try {ok, binary_to_integer(Value)}
+    catch error:badarg -> error
+    end.
+
 %% @doc Determine if the stream should be finalized.
 should_finalize_stream(429, _EncodedBody) -> true;
 should_finalize_stream(_, _EncodedBody) -> false.
